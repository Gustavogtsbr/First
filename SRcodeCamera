-- ========================================================= --
-- PARTE 2: CONFIGURAÇÃO INICIAL
-- ========================================================= --

ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ========================================================= --
-- PARTE 3: LÓGICA DOS BOTÕES (CORRIGIDA)
-- ========================================================= --

-- Botão ABRIR
Open.MouseButton1Click:Connect(function()
	Frame.Visible = false
	Frame1.Visible = true
end)

-- Botão FECHAR
Close.MouseButton1Click:Connect(function()
	Frame1.Visible = false
	Frame.Visible = true
end)

-- Botão GO (Câmera Scriptable)
Go.MouseButton1Click:Connect(function()
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.new(-527.827, 95.358, 426.210) * CFrame.Angles(math.rad(37.54), math.rad(32.53), math.rad(0.00))
end)

-- Botão BACK (Volta para o Personagem)
Back.MouseButton1Click:Connect(function()
	local camera = workspace.CurrentCamera
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid
end)
