    local abilityWarningAt = 0
    while alive do
            -- Separate worker: independent of the farm start/stop tasks.
            if observedAbilityRevision ~= abilitySettingsRevision then
                observedAbilityRevision = abilitySettingsRevision
                nextAbilityAt = os.clock()+abilityInterval
            end
            local abilityCharacter = LP.Character
            local abilityRoot = abilityCharacter and abilityCharacter:FindFirstChild('HumanoidRootPart')
            local abilityHumanoid = abilityCharacter and abilityCharacter:FindFirstChildWhichIsA('Humanoid')
            local abilityReady = abilityRoot and abilityHumanoid and abilityHumanoid.Health > 0
                and abilityCharacter:FindFirstChild('entered')
            if abilityEnabled and abilityReady and not teleporting and os.clock() >= nextAbilityAt then
                nextAbilityAt = os.clock()+abilityInterval
                local ok,err = pcall(function()
                    local event = game:GetService('ReplicatedStorage'):FindFirstChild('GeneralAbility')
                    assert(event and event:IsA('RemoteEvent'),'GeneralAbility indisponível')
                    event:FireServer()
                end)
                if not ok and os.clock() >= abilityWarningAt then
                    abilityWarningAt = os.clock()+5
                    warn('Auto habilidade: '..tostring(err))
                end
            end
        task.wait(.05)
    end
