                                if ownCharacter and ownCharacter:FindFirstChild('entered') and ownHumanoid and ownHumanoid.Health > 0 then
                                    -- Attempt a self-hit through the same event as the aura.
                                    -- Server validation may reject self-targets.
                                    local ownRoot = ownCharacter:FindFirstChild('HumanoidRootPart')
                                    if ownRoot and active() and auraEnabled then
                                        pcall(function() remote:FireServer(ownRoot) end)
                                    end
                                    for _,target in ipairs(Players:GetPlayers()) do
                                        if not active() or not auraEnabled or teleporting then break end
                                        if target ~= LP then
                                            local character = target.Character
                                            local root = character and character:FindFirstChild('HumanoidRootPart')
                                            local humanoid = character and character:FindFirstChildWhichIsA('Humanoid')
                                            if root and humanoid and humanoid.Health > 0 and character:FindFirstChild('entered') then
                                                pcall(function() remote:FireServer(root) end)
                                            end
                                        end
                                    end
                                end
                            elseif not warnedMissing then
                                warnedMissing = true
                                warn('Slap Aura: GeneralHit indisponível; Slapple, Candy e servidores continuam ativos.')
                            end
                        end
                        task.wait(.25)
                    end
                end)
            end
            if elapsed >= 4.2 and not collected then
                collected = true
                spawnInto(farmTasks,function()
                    local ok,err = pcall(function()
                        repeat task.wait() until LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
                        if not LP.Character:FindFirstChild('entered') then
