        fetchKey = 'searching'
        fetchTask = task.defer(function()
            local url = 'https://games.roblox.com/v1/games/'..game.PlaceId
                ..'/servers/Public?sortOrder=Asc&limit=100'
            if cursor then url = url..'&cursor='..Http:UrlEncode(cursor) end
            local ok,data = pcall(function()
                return Http:JSONDecode(game:HttpGetAsync(url))
            end)
            if not active() or epoch ~= fetchEpoch then return end
            fetching = false
            if ok and type(data) == 'table' and type(data.data) == 'table' then
                local added = {}
                for _,id in ipairs(destinations) do added[id] = true end
                for _,server in ipairs(data.data) do
                    if type(server) == 'table' and type(server.id) == 'string'
                        and server.id ~= game.JobId
                        and not hopState.visited[server.id] and not added[server.id]
                        and type(server.playing) == 'number'
                        and type(server.maxPlayers) == 'number'
                        and server.playing < server.maxPlayers
                        and (rejected[server.id] or 0) <= os.clock() then
                        added[server.id] = true
                        table.insert(destinations,server.id)
                    end
                end
                hopState.fetchedAt = os.time()
                local nextCursor = data.nextPageCursor
                cursor = type(nextCursor) == 'string' and nextCursor ~= ''
                    and nextCursor ~= cursor and nextCursor or nil
                hopState.cursor = cursor
                nextFetchAt = os.clock()+3
                fetchKey = #destinations > 0 and 'ready' or 'noNew'
            else
                nextFetchAt = os.clock()+3
                fetchKey = 'refused'
