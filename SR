local isFastSpeedActive = itemsConfig.fastSpeed
local originalRightLegC0 = nil

if isFastSpeedActive then
    toggleFastSpeedBtn.Text = "On"
    toggleFastSpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
end

local function getRightLegJoint(character)
    if not character then return nil end
    local rightLeg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("LowerTorso")
    if rightLeg and torso then
        return rightLeg:FindFirstChildOfClass("Motor6D")
            or torso:FindFirstChild("Right Hip")
            or torso:FindFirstChild("RightUpperHip")
            or rightLeg:FindFirstChild("RightUpperHip")
    end
    return nil
end

toggleFastSpeedBtn.MouseButton1Click:Connect(function()
    isFastSpeedActive = not isFastSpeedActive
    itemsConfig.fastSpeed = isFastSpeedActive
    saveLocalConfig()

    toggleFastSpeedBtn.Text = isFastSpeedActive and "On" or "Off"
    toggleFastSpeedBtn.BackgroundColor3 = isFastSpeedActive and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(180, 50, 50)

    if not isFastSpeedActive then
        local joint = getRightLegJoint(LocalPlayer.Character)
        if joint and originalRightLegC0 then
            joint.C0 = originalRightLegC0
            originalRightLegC0 = nil
        end
    end
end)

RunService.Stepped:Connect(function()
    if not isFastSpeedActive then return end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    local joint = getRightLegJoint(character)
    if joint then
        if not originalRightLegC0 then originalRightLegC0 = joint.C0 end
        joint.C0 = CFrame.new(30, -1, 0)
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    originalRightLegC0 = nil
end)

