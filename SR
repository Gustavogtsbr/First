local isRunningCombo = false

toggleButton.MouseButton1Click:Connect(function()
    if isRunningCombo then return end
    isRunningCombo = true

    toggleButton.Text = "On"
    toggleButton.BackgroundColor3 = Color3.fromRGB(50, 180, 80)

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")

    local itemsFolder = Workspace:FindFirstChild("Items")
    local truePowerItem = itemsFolder and itemsFolder:FindFirstChild("True Power")
    local cubeOfIceItem = itemsFolder and itemsFolder:FindFirstChild("Cube of Ice")

    if not itemsFolder or not truePowerItem or not cubeOfIceItem then
        showNotification("Error", "True Power or Cube of Ice not found! Try again in another round.")
        isRunningCombo = false
        toggleButton.Text = "Off"
        toggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        return
    end

    if truePowerItem:IsA("BasePart") then
        rootPart.CFrame = truePowerItem.CFrame
    elseif truePowerItem:IsA("Model") then
        rootPart.CFrame = truePowerItem:GetPivot()
    end
    safeWait(0.15, 0.7)
    pressKeyTwoTimes(Enum.KeyCode.F)
    safeWait(0.4, 0.6)

    if cubeOfIceItem:IsA("BasePart") then
        rootPart.CFrame = cubeOfIceItem.CFrame
    elseif cubeOfIceItem:IsA("Model") then
        rootPart.CFrame = cubeOfIceItem:GetPivot()
    end
    safeWait(0.15, 0.7)
    pressKeyTwoTimes(Enum.KeyCode.F)
    safeWait(0.4, 0.6)

    local busModel = Workspace:WaitForChild("BusModel")
    local busStartTime = tick()

    local remotes = ReplicatedStorage:WaitForChild("Remotes")
    local busJumpingEvent = remotes:WaitForChild("BusJumping")
    busJumpingEvent:FireServer()

    forceAirTeleport(rootPart, character)

    equipItemByName("Cube of Ice")
    clickScreen()

    -- Gap ice -> power com margem de ping (o slack final absorve o atraso)
    safeWait(3.85, 0.4)

    equipItemByName("True Power")
    clickScreen()

    local elapsedTime = tick() - busStartTime
    local remainingCountdown = 7 - elapsedTime
    if remainingCountdown > 0 then
        task.wait(remainingCountdown)
    end

    local targetPlayer = nil
    repeat
        targetPlayer = getClosestVisiblePlayerToBus(busModel)
        if not targetPlayer then
            task.wait(0.05)
        end
    until targetPlayer or not isRunningCombo or not character.Parent

    if targetPlayer then
        local targetCharInWorkspace = Workspace:FindFirstChild(targetPlayer.Name)
        if targetCharInWorkspace and targetCharInWorkspace:FindFirstChild("HumanoidRootPart") then
            local targetRoot = targetCharInWorkspace.HumanoidRootPart

            equipItemByName("Pow")
            safeWait(0.1, 0.7)

            rootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)

            local originalGravity = Workspace.Gravity
            Workspace.Gravity = 0

            local zeroVelocityConnection
            zeroVelocityConnection = RunService.Stepped:Connect(function()
                if rootPart and rootPart.Parent then
                    rootPart.AssemblyLinearVelocity = Vector3.zero
                    rootPart.AssemblyAngularVelocity = Vector3.zero
                end
            end)

            safeWait(0.25, 0.7)

            local slapEvent = remotes:WaitForChild("Slap")
            slapEvent:FireServer(Workspace[targetPlayer.Name].HumanoidRootPart)

            safeWait(0.25, 0.6)

            slapEvent:FireServer(Workspace[targetPlayer.Name].HumanoidRootPart)

            if zeroVelocityConnection then
                zeroVelocityConnection:Disconnect()
            end
            Workspace.Gravity = originalGravity
        else
            showNotification("Error", "No valid target player found near BusModel.")
        end
    else
        showNotification("Error", "No valid target player found near BusModel.")
    end

    isRunningCombo = false
    toggleButton.Text = "Off"
    toggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
end)

