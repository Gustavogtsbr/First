local function getItemCFrame(item)
    if not item or not item.Parent then return nil end
    if item:IsA("BasePart") then return item.CFrame end
    if item:IsA("Model") then return item:GetPivot() end
    return nil
end

local function teleportToCFrame(rootPart, targetCFrame)
    rootPart.CFrame = targetCFrame + Vector3.new(0, itemsConfig.teleOffsetY, 0)
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
end

local function getClosestVisiblePlayerToBus(busModel, excludedPlayers)
    if not busModel or not busModel.Parent then return nil end
    local busPosition = busModel:GetPivot().Position
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and (not excludedPlayers or not excludedPlayers[player]) then
            local charInWorkspace = Workspace:FindFirstChild(player.Name)
            if charInWorkspace then
                local targetRoot = charInWorkspace:FindFirstChild("HumanoidRootPart")
                local targetHumanoid = charInWorkspace:FindFirstChildOfClass("Humanoid")
                local torso = charInWorkspace:FindFirstChild("Torso") or charInWorkspace:FindFirstChild("UpperTorso")
                if targetRoot and targetHumanoid and targetHumanoid.Health > 0 and torso and torso.Transparency == 0 then
                    local distance = (targetRoot.Position - busPosition).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function forceAirTeleport(rootPart, character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.Sit = false end

    local targetDestination = CFrame.new(101.497314453125, 96.10908508300781, 28.451526641845703)
    local startTime = tick()
    local duration = 0.35 + pingExtra(0.8)

    while tick() - startTime < duration do
        if humanoid then humanoid.Sit = false end
        character:PivotTo(targetDestination)
        rootPart.CFrame = targetDestination
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        RunService.RenderStepped:Wait()
    end
end

