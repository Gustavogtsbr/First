local antiKnockbackWalls = {}

-- Limpa as barreiras físicas do Workspace
local function removeAntiKBDualWalls()
    for _, wall in ipairs(antiKnockbackWalls) do
        if wall and wall.Parent then
            wall:Destroy()
        end
    end
    table.clear(antiKnockbackWalls)
end

local wallOffsets = {
    CFrame.new(0, 0, -2.5),  -- Frente
    CFrame.new(0, 0, 2.5),   -- Trás
    CFrame.new(-2.5, 0, 0),  -- Esquerda
    CFrame.new(2.5, 0, 0),   -- Direita
    CFrame.new(0, 3.5, 0),   -- Cima
    CFrame.new(0, -3.5, 0)   -- Baixo
}

local wallSizes = {
    Vector3.new(5, 6, 0.5),
    Vector3.new(5, 6, 0.5),
    Vector3.new(0.5, 6, 5),
    Vector3.new(0.5, 6, 5),
    Vector3.new(5, 0.5, 5),
    Vector3.new(5, 0.5, 5)
}

-- Monitoramento via Heartbeat
RunService.Heartbeat:Connect(function()
    if not itemsConfig.antiKnockback then
        removeAntiKBDualWalls()
        return
    end

    local character = LocalPlayer.Character
    if not character then
        removeAntiKBDualWalls()
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not rootPart then
        removeAntiKBDualWalls()
        return
    end

    -- Condição estrita: Verifica a existência do 'FakePart' no personagem antes de criar/manter barreiras
    local fakePart = character:FindFirstChild("FakePart")
    if not fakePart then
        removeAntiKBDualWalls()
        return
    end

    -- Instancia as 6 paredes transparentes apenas se o FakePart for detectado
    if #antiKnockbackWalls == 0 then
        for i = 1, 6 do
            local wall = Instance.new("Part")
            wall.Name = "AntiKB_BarrierPart"
            wall.Transparency = 1
            wall.Anchored = true
            wall.CanCollide = true
            wall.Material = Enum.Material.SmoothPlastic
            wall.Size = wallSizes[i]
            wall.Parent = Workspace
            table.insert(antiKnockbackWalls, wall)
        end
    end

    -- Atualiza a posição das barreiras ao redor do HumanoidRootPart
    for i, offset in ipairs(wallOffsets) do
        local wall = antiKnockbackWalls[i]
        if wall and wall.Parent then
            wall.CFrame = rootPart.CFrame * offset
        end
    end
end)

