toggleAntiKBBtn.MouseButton1Click:Connect(function()
    itemsConfig.antiKnockback = not itemsConfig.antiKnockback
    saveLocalConfig()
    toggleAntiKBBtn.Text = itemsConfig.antiKnockback and "On" or "Off"
    toggleAntiKBBtn.BackgroundColor3 = itemsConfig.antiKnockback and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(180, 50, 50)
end)

local antiKnockbackWalls = {}

local function removeAntiKBDualWalls()
    for _, wall in ipairs(antiKnockbackWalls) do
        if wall and wall.Parent then wall:Destroy() end
    end
    table.clear(antiKnockbackWalls)
end

local wallOffsets = {
    CFrame.new(0, 0, -2.5), CFrame.new(0, 0, 2.5),
    CFrame.new(-2.5, 0, 0), CFrame.new(2.5, 0, 0),
    CFrame.new(0, 3.5, 0), CFrame.new(0, -3.5, 0)
}
local wallSizes = {
    Vector3.new(5, 6, 0.5), Vector3.new(5, 6, 0.5),
    Vector3.new(0.5, 6, 5), Vector3.new(0.5, 6, 5),
    Vector3.new(5, 0.5, 5), Vector3.new(5, 0.5, 5)
}

RunService.Heartbeat:Connect(function()
    if not itemsConfig.antiKnockback then removeAntiKBDualWalls(); return end

    local character = LocalPlayer.Character
    if not character then removeAntiKBDualWalls(); return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not rootPart then removeAntiKBDualWalls(); return end
    if not character:FindFirstChild("FakePart") then removeAntiKBDualWalls(); return end

    if #antiKnockbackWalls == 0 then
        for i = 1, 6 do
            local wall = Instance.new("Part")
            wall.Name = "AntiKB_BarrierPart"
            wall.Transparency = 1
            wall.Anchored = true
            wall.CanCollide = true
            wall.Material = Enum.Material.SmoothPlastic
            wall.Size = wallSizes[i]
            wall.Parent = Workspace
            table.insert(antiKnockbackWalls, wall)
        end
    end

    for i, offset in ipairs(wallOffsets) do
        local wall = antiKnockbackWalls[i]
        if wall and wall.Parent then wall.CFrame = rootPart.CFrame * offset end
    end
end)

