            w.Material = Enum.Material.SmoothPlastic
            w.Size = wallSizes[i]
            w.Parent = Workspace
            table.insert(antiKnockbackWalls, w)
        end
    end
    for i, offset in ipairs(wallOffsets) do
        local w = antiKnockbackWalls[i]
