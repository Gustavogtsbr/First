    lbl.Parent = configFrame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 60, 0, 24)
    box.Position = UDim2.new(1, -70, 0, yPos)
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 54)
