    local totalUsed = 0
    for _, targetName in ipairs(permanentItemNames) do
        while true do
            if not equipItemByName(targetName) then break end
            safeWait(0.1, 0.6)
            clickScreen()
            safeWait(0.15, 0.6)
            totalUsed = totalUsed + 1
        end
    end

    if totalUsed > 0 then
        showNotification("Success", "Finished using all permanent items (" .. tostring(totalUsed) .. " used).")
    else
        showNotification("Warning", "No permanent items found in Backpack or Character.")
    end
end)

