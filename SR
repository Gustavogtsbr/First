local customWalkSpeed = nil
local lastValidWalkSpeed = 16
local customJumpPower = nil
local lastValidJumpPower = 50
local infiniteJumpActive = false

RunService.RenderStepped:Connect(function()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if customWalkSpeed then
            humanoid.WalkSpeed = customWalkSpeed
        else
            lastValidWalkSpeed = humanoid.WalkSpeed
            if not boxSpeed:IsFocused() then boxSpeed.Text = tostring(math.floor(humanoid.WalkSpeed + 0.5)) end
        end

        if customJumpPower then
            humanoid.JumpPower = customJumpPower
        else
            lastValidJumpPower = humanoid.JumpPower
            if not boxJumpPower:IsFocused() then boxJumpPower.Text = tostring(math.floor(humanoid.JumpPower + 0.5)) end
        end
    end
end)

boxSpeed.FocusLost:Connect(function()
    local parsed = tonumber(boxSpeed.Text)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if parsed and humanoid then
        if parsed > lastValidWalkSpeed then
            showNotification("Warning", "Cannot increase speed due to anti-cheat system.")
            boxSpeed.Text = tostring(customWalkSpeed or lastValidWalkSpeed)
        else
            customWalkSpeed = parsed
            humanoid.WalkSpeed = parsed
        end
    else
        boxSpeed.Text = tostring(customWalkSpeed or lastValidWalkSpeed)
    end
end)

boxJumpPower.FocusLost:Connect(function()
    local parsed = tonumber(boxJumpPower.Text)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if parsed and humanoid then
        if parsed > lastValidJumpPower then
            showNotification("Warning", "Cannot increase JumpPower due to anti-cheat system.")
            boxJumpPower.Text = tostring(customJumpPower or lastValidJumpPower)
        else
            customJumpPower = parsed
            humanoid.JumpPower = parsed
        end
    else
        boxJumpPower.Text = tostring(customJumpPower or lastValidJumpPower)
    end
end)

