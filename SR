--------------------------------------------------------------------------------
-- 1. SISTEMA DE PING DINÂMICO (COMPENSAÇÃO DE LATÊNCIA ANTI-KICK)
--------------------------------------------------------------------------------
-- Todas as esperas do script foram originalmente calibradas para ~60ms de ping.
-- Em ping alto, o servidor recebe cada ação atrasada, e o anti-cheat pode te
-- expulsar por "velocidade/teleporte" fora do padrão. Aqui medimos o ping real
-- e adicionamos automaticamente uma margem proporcional a TODA espera crítica,
-- de modo que o servidor registre cada ação antes da próxima.

local PING_BASELINE = 60        -- ping para o qual as esperas base foram calibradas
local PING_MAX_EXTRA = 0.55     -- teto máximo de margem extra por espera (segundos)

local pingState = {
    raw = PING_BASELINE,
    smooth = PING_BASELINE
}

local function samplePing()
    local p = 0
    pcall(function()
        p = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if not p or p <= 0 then
        pcall(function()
            p = LocalPlayer:GetNetworkPing() * 1000
        end)
    end
    if p and p > 0 then
        pingState.raw = p
        pingState.smooth = pingState.smooth + (p - pingState.smooth) * 0.35
    end
end

task.spawn(function()
    while true do
        samplePing()
        task.wait(0.5)
    end
end)

-- Margem extra (segundos) proporcional ao excesso de ping acima do baseline.
-- factor controla o quão agressiva é a compensação para cada tipo de ação.
local function pingExtra(factor)
    factor = factor or 1.0
    local excess = math.max(0, pingState.smooth - PING_BASELINE)
    return math.min((excess / 1000) * factor, PING_MAX_EXTRA)
end

-- Espera segura: valor base + margem de ping. Substitui os task.wait fixos.
local function safeWait(base, factor)
    task.wait(base + pingExtra(factor or 1.0))
end

