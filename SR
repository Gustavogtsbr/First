    toggleItemsButton.Active = false

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    local itemsFolder = Workspace:FindFirstChild("Items")
    if not itemsFolder then
        showNotification("Error", "Items folder not found in Workspace.")
        isRunningEarlyCollect = false
        earlyCollectFinished = true
        toggleItemsButton.Text = "Off"
        toggleItemsButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        return
    end

    local priorityOrder = {
        "True Power",
        "Potion of Strength",
        "Bull's essence",
        "Boba",
        "Speed Potion",
        "Frog Potion"
    }

    local teleportCounter = 0
    local busWarningShown = false
    local busJumpingFired = false
    local failedItems = {}

    -- Função utilitária para execução de 1 teleporte e tentativa de coleta por item
    local function attemptCollectItem(item)
        if not item or not item.Parent or item.Parent ~= itemsFolder or failedItems[item] then
            return false
        end

        local currentBus = Workspace:FindFirstChild("BusModel")
        if currentBus and not busJumpingFired then
            busJumpingFired = true

            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes and remotes:FindFirstChild("BusJumping") then
                    remotes.BusJumping:FireServer()
                end
            end)

            safeWait(0.25, 0.7)

            humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.Sit = false
                humanoid.Jump = true
            end

            if item:IsA("BasePart") then
                rootPart.CFrame = item.CFrame
            elseif item:IsA("Model") then
                rootPart.CFrame = item:GetPivot()
            end

            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero

            if not busWarningShown then
                showNotification("Warning", "Don't pick up the item or you'll be kicked.")
                busWarningShown = true
            end

            safeWait(11.0, 0.5)

            pressKeyTwoTimes(Enum.KeyCode.F)
            safeWait(itemsConfig.waitNext, 0.8)
        else
            humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.Sit = false
                humanoid.Jump = true
            end

            if item:IsA("BasePart") then
                rootPart.CFrame = item.CFrame
            elseif item:IsA("Model") then
                rootPart.CFrame = item:GetPivot()
            end

            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero

            safeWait(itemsConfig.waitCollect, 0.8)
            pressKeyTwoTimes(Enum.KeyCode.F)
            safeWait(itemsConfig.waitNext, 0.8)
        end

        teleportCounter = teleportCounter + 1

        if item and item.Parent == itemsFolder then
            failedItems[item] = true
        end

        -- Pausa de 2 segundos a cada 4 TELEPORTES efetuados
        if teleportCounter > 0 and teleportCounter % 4 == 0 then
            task.wait(2.0)
        end

        return true
    end

    ----------------------------------------------------------------------------
    -- FASE 1: Coleta inicial limitada a no máximo 2 itens antes de aguardar o ônibus
    ----------------------------------------------------------------------------
    local initialItemsTeleported = 0
    for _, itemName in ipairs(priorityOrder) do
        if initialItemsTeleported >= 2 then break end
        for _, itemObj in ipairs(itemsFolder:GetChildren()) do
            if not character.Parent then break end
            if initialItemsTeleported >= 2 then break end

            if itemObj.Name == itemName and not failedItems[itemObj] then
                attemptCollectItem(itemObj)
                initialItemsTeleported = initialItemsTeleported + 1
            end
        end
    end

    ----------------------------------------------------------------------------
    -- FASE 2: Aguarda explicitamente o aparecimento do BusModel no Workspace
    ----------------------------------------------------------------------------
    while not Workspace:FindFirstChild("BusModel") and character.Parent do
        task.wait(0.5)
    end

    ----------------------------------------------------------------------------
    -- FASE 3: Varredura dos itens restantes após o ônibus aparecer
    ----------------------------------------------------------------------------
    for _, itemName in ipairs(priorityOrder) do
        for _, itemObj in ipairs(itemsFolder:GetChildren()) do
            if not character.Parent then break end
            if itemObj.Name == itemName and not failedItems[itemObj] then
                attemptCollectItem(itemObj)
            end
        end
    end

    -- Confirmação final para verificar se sobrou algum item elegível da lista
    for _, itemName in ipairs(priorityOrder) do
        for _, itemObj in ipairs(itemsFolder:GetChildren()) do
            if not character.Parent then break end
            if itemObj.Name == itemName and not failedItems[itemObj] and itemObj.Parent == itemsFolder then
                attemptCollectItem(itemObj)
            end
        end
    end

    isRunningEarlyCollect = false
    earlyCollectFinished = true

    toggleItemsButton.Text = "Off"
    toggleItemsButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    toggleItemsButton.AutoButtonColor = false
    toggleItemsButton.Active = false
end)

