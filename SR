local function cleanupESPTable(tbl)
    for target, gui in pairs(tbl) do
        if not target or not target.Parent or not gui.Parent then
            if gui then gui:Destroy() end
            tbl[target] = nil
        end
    end
end

RunService.RenderStepped:Connect(function()
    if itemsConfig.playersESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character.Parent then
                local character = player.Character
                local head = character:FindFirstChild("Head")
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if head and humanoid and humanoid.Health > 0 then
                    local bbGui = activePlayerESPs[player]
                    if not bbGui or not bbGui.Parent then
                        bbGui = Instance.new("BillboardGui")
                        bbGui.Name = "PlayerESP_Gui"
                        bbGui.Size = UDim2.new(0, 160, 0, 45)
                        bbGui.StudsOffset = Vector3.new(0, 2.5, 0)
                        bbGui.AlwaysOnTop = true
                        bbGui.Parent = head

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "ESPLabel"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        textLabel.TextStrokeTransparency = 0.2
                        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        textLabel.TextSize = 11
                        textLabel.Font = Enum.Font.SourceSansBold
                        textLabel.Parent = bbGui

                        activePlayerESPs[player] = bbGui
                    end

                    local label = bbGui:FindFirstChild("ESPLabel")
                    if label then
                        local currentHP = math.floor(humanoid.Health + 0.5)
                        local maxHP = math.floor(humanoid.MaxHealth + 0.5)
                        local speed = math.floor(humanoid.WalkSpeed + 0.5)
                        local jump = math.floor(humanoid.JumpPower + 0.5)
                        label.Text = string.format("%s\nHP: %d/%d | Spd: %d | Jump: %d", player.Name, currentHP, maxHP, speed, jump)
                    end
                else
                    if activePlayerESPs[player] then
                        activePlayerESPs[player]:Destroy()
                        activePlayerESPs[player] = nil
                    end
                end
            else
                if activePlayerESPs[player] then
                    activePlayerESPs[player]:Destroy()
                    activePlayerESPs[player] = nil
                end
            end
        end
    else
        cleanupESPTable(activePlayerESPs)
    end

    if itemsConfig.itemsESP then
        local itemsFolder = Workspace:FindFirstChild("Items")
        if itemsFolder then
            for _, itemObj in ipairs(itemsFolder:GetChildren()) do
                local targetPart = itemObj:IsA("BasePart") and itemObj or (itemObj:IsA("Model") and (itemObj.PrimaryPart or itemObj:FindFirstChildWhichIsA("BasePart")))
                if targetPart then
                    local bbGui = activeItemESPs[itemObj]
                    if not bbGui or not bbGui.Parent then
                        bbGui = Instance.new("BillboardGui")
                        bbGui.Name = "ItemESP_Gui"
                        bbGui.Size = UDim2.new(0, 140, 0, 30)
                        bbGui.StudsOffset = Vector3.new(0, 1.5, 0)
                        bbGui.AlwaysOnTop = true
                        bbGui.Parent = targetPart

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "ItemLabel"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextStrokeTransparency = 0.2
                        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        textLabel.TextSize = 12
                        textLabel.Font = Enum.Font.SourceSansBold
                        textLabel.Text = itemObj.Name
                        textLabel.TextColor3 = itemColorMap[itemObj.Name] or Color3.fromRGB(255, 255, 0)
                        textLabel.Parent = bbGui

                        activeItemESPs[itemObj] = bbGui
                    end
                end
            end
        end
    else
        cleanupESPTable(activeItemESPs)
    end
end)
