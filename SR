        counter = counter + 1
        if item.Parent == itemsFolder then done[item] = true end
        if counter % 4 == 0 then task.wait(2.0) end
    end

    for _, item in ipairs(itemsFolder:GetChildren()) do
        if not character.Parent then break end
        collect(item)
    end
    for _, item in ipairs(itemsFolder:GetChildren()) do
        if not character.Parent then break end
        if not done[item] and item.Parent == itemsFolder then collect(item) end
    end

