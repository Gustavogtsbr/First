    earlyCollectActive = not earlyCollectActive
    setToggle(toggleItemsButton, earlyCollectActive)

    if earlyCollectActive then
        showNotification("Early Collect", "Ligado. Nao pegue o item na mao.")
        task.spawn(earlyCollectLoop)
    else
        showNotification("Early Collect", "Desligado.")
    end
end)

