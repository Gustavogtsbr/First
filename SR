-- Função que bloqueia se o alvo possuir qualquer parte que COMEÇA com "FakePart"
local function targetHasFakePart(targetChar)
    if not targetChar then return false end

    for _, descendant in ipairs(targetChar:GetDescendants()) do
        if descendant:IsA("BasePart") then
            if string.sub(descendant.Name, 1, 8) == "FakePart" then
                return true
            end
        end
    end

    return false
end

-- Loop principal do Slap Aura (cooldown escalado por ping)
RunService.Heartbeat:Connect(function()
    if not itemsConfig.slapAura then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHumanoid or myHumanoid.Health <= 0 then return end

    -- Bloqueia a execução se NÃO estiver segurando uma das ferramentas permitidas
    if not isHoldingAllowedTool(myChar) then return end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local slapEvent = remotes and remotes:FindFirstChild("Slap")
    if not slapEvent then return end

    -- Cooldown base de 0.5s + margem de ping para não disparar mais rápido que o servidor aceita
    local cooldown = 0.5 + pingExtra(0.4)

    local closestTarget = nil
    local shortestDistance = 23

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= LocalPlayer then
            local targetChar = targetPlayer.Character
            if targetChar and targetChar.Parent then
                local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")

                if targetHumanoid and targetHumanoid.Health > 0 and targetRoot then
                    if not targetHasFakePart(targetChar) then
                        local distance = (targetRoot.Position - myRoot.Position).Magnitude
                        if distance <= shortestDistance then
                            local now = tick()
                            local lastSlapTime = lastSlapPerTarget[targetPlayer] or 0
                            if (now - lastSlapTime) >= cooldown then
                                shortestDistance = distance
                                closestTarget = targetPlayer
                            end
                        end
                    end
                end
            end
        end
    end

    if closestTarget and closestTarget.Character then
        local targetRoot = closestTarget.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            lastSlapPerTarget[closestTarget] = tick()
            slapEvent:FireServer(targetRoot)
        end
    end
end)

-- Loop principal do AimBot Tomahawk
