--------------------------------------------------------------------------------
-- PING
--------------------------------------------------------------------------------

local PING_BASELINE = 60
local PING_MAX_EXTRA = 0.35
local pingState = { raw = PING_BASELINE, smooth = PING_BASELINE }

local function samplePing()
    local p = 0
    pcall(function() p = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if not p or p <= 0 then pcall(function() p = LocalPlayer:GetNetworkPing() * 1000 end) end
    if p and p > 0 then
        pingState.raw = p
        pingState.smooth = pingState.smooth + (p - pingState.smooth) * 0.2
    end
end

task.spawn(function()
    while true do
        samplePing()
        task.wait(0.5)
    end
end)

local function pingExtra(factor)
    factor = factor or 1.0
    local excess = math.max(0, pingState.smooth - PING_BASELINE)
    return math.min((excess / 1000) * factor, PING_MAX_EXTRA)
end

local function safeWait(base, factor)
    task.wait(base + pingExtra(factor or 1.0))
end

