local wallOffsets = {
    CFrame.new(0, 0, -2.5), CFrame.new(0, 0, 2.5),
    CFrame.new(-2.5, 0, 0), CFrame.new(2.5, 0, 0),
    CFrame.new(0, 3.5, 0), CFrame.new(0, -3.5, 0)
}
local wallSizes = {
    Vector3.new(5, 6, 0.5), Vector3.new(5, 6, 0.5),
