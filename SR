local EARLY_TARGETS = { "Boba", "Buba", "Bull's essence" }
local earlyCollectActive = false
local earlyCollectRunning = false

-- Dispara o VFX "ItemLerp" (item voando ate o player), igual o servidor faz.
-- Usa o TEU nick como TargetPlayer e o Handle do item.
local function fireItemVFX(item, targetPlayer)
    if not firesignal then return end
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local vfx = remotes and remotes:FindFirstChild("VFX")
        if not vfx then return end
        local handle = getItemHandle(item)
        if not handle then return end
        firesignal(vfx.OnClientEvent, "ItemLerp", {
            Handle = handle,
            Duration = 0.35,
            TargetPlayer = targetPlayer or Players[MY_NAME] or LocalPlayer
        })
    end)
end

local function earlyCollectLoop()
    if earlyCollectRunning then return end
    earlyCollectRunning = true

    -- pula do onibus cedo (uma vez)
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes and remotes:FindFirstChild("BusJumping") then remotes.BusJumping:FireServer() end
    end)
    task.wait(0.25)

    while earlyCollectActive do
        local itemsFolder = Workspace:FindFirstChild("Items")
        local character = LocalPlayer.Character
        if itemsFolder and character and character.Parent then
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if rootPart and humanoid and humanoid.Health > 0 then
                humanoid.Sit = false
                humanoid.Jump = true

                for _, name in ipairs(EARLY_TARGETS) do
                    if not earlyCollectActive then break end
                    for _, item in ipairs(itemsFolder:GetChildren()) do
                        if item.Name == name then
                            local cf = getItemCFrame(item)
                            if cf then
                                teleportToCFrame(rootPart, cf)
                                tapF()
                                fireItemVFX(item, LocalPlayer)
                            end
                            break
                        end
                    end
                end
            end
        end
        task.wait(itemsConfig.collectInterval or 0.1)
    end

    earlyCollectRunning = false
end

