-- 2. CONFIG
--------------------------------------------------------------------------------

local CONFIG_FILE_NAME = "SlapRoyaleHub_ItemsConfig.json"

local itemsConfig = {
    waitNext = 0.6,
    waitCollect = 0.6,
    busWait = 5.0,        -- espera do onibus antes de coletar o 1o item
    teleOffsetY = 2,      -- sobe o personagem no tp (anti-clipping)
    skipItems = "",       -- nomes separados por virgula para IGNORAR
    slapAura = false,
    aimBotTomahawk = false,
    playersESP = false,
    itemsESP = false,
    antiKnockback = false,
    autoRejoin = true,
    fastSpeed = false
}

local function loadLocalConfig()
    pcall(function()
        if readfile and isfile and isfile(CONFIG_FILE_NAME) then
            local decoded = HttpService:JSONDecode(readfile(CONFIG_FILE_NAME))
            if type(decoded) == "table" then
                if type(decoded.waitNext) == "number" and decoded.waitNext > 0 then itemsConfig.waitNext = decoded.waitNext end
                if type(decoded.waitCollect) == "number" and decoded.waitCollect > 0 then itemsConfig.waitCollect = decoded.waitCollect end
                if type(decoded.busWait) == "number" and decoded.busWait > 0 then itemsConfig.busWait = decoded.busWait end
                if type(decoded.teleOffsetY) == "number" then itemsConfig.teleOffsetY = decoded.teleOffsetY end
                if type(decoded.skipItems) == "string" then itemsConfig.skipItems = decoded.skipItems end
                if type(decoded.slapAura) == "boolean" then itemsConfig.slapAura = decoded.slapAura end
                if type(decoded.aimBotTomahawk) == "boolean" then itemsConfig.aimBotTomahawk = decoded.aimBotTomahawk end
                if type(decoded.playersESP) == "boolean" then itemsConfig.playersESP = decoded.playersESP end
                if type(decoded.itemsESP) == "boolean" then itemsConfig.itemsESP = decoded.itemsESP end
                if type(decoded.antiKnockback) == "boolean" then itemsConfig.antiKnockback = decoded.antiKnockback end
                if type(decoded.autoRejoin) == "boolean" then itemsConfig.autoRejoin = decoded.autoRejoin end
                if type(decoded.fastSpeed) == "boolean" then itemsConfig.fastSpeed = decoded.fastSpeed end
            end
        end
    end)
end

local function saveLocalConfig()
    pcall(function()
        if writefile then writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(itemsConfig)) end
    end)
end

loadLocalConfig()

local skipSet = {}
local function rebuildSkipSet()
    table.clear(skipSet)
    for name in string.gmatch(itemsConfig.skipItems or "", "([^,]+)") do
        local trimmed = name:match("^%s*(.-)%s*$")
        if trimmed ~= "" then skipSet[trimmed] = true end
    end
end
rebuildSkipSet()

