local CONFIG_FILE_NAME = "SlapRoyaleHub_ItemsConfig.json"

-- Estrutura de memória para carregar os parâmetros configuráveis pelo usuário
local itemsConfig = {
    waitNext = 0.4,       -- Tempo de espera até teleportar para o próximo item
    waitCollect = 0.15,   -- Tempo de espera para coletar ao teleportar
    slapAura = false,     -- Estado persistente do Slap Aura (On / Off)
    aimBotTomahawk = false,-- Estado persistente do AimBot com Tomahawk
    playersESP = false,   -- Estado persistente do ESP de Jogadores
    itemsESP = false,     -- Estado persistente do ESP de Itens
    antiKnockback = false,-- Estado persistente do Anti KnockBack
    autoRejoin = true,    -- Estado persistente do Auto Rejoin (On por padrão)
    fastSpeed = false     -- Estado persistente do Fast Speed
}

-- Leitura e parsing de configurações persistentes salvas na memória física do dispositivo
local function loadLocalConfig()
    pcall(function()
        if readfile and isfile and isfile(CONFIG_FILE_NAME) then
            local fileData = readfile(CONFIG_FILE_NAME)
            local decoded = HttpService:JSONDecode(fileData)
            if type(decoded) == "table" then
                if type(decoded.waitNext) == "number" and decoded.waitNext > 0 then
                    itemsConfig.waitNext = decoded.waitNext
                end
                if type(decoded.waitCollect) == "number" and decoded.waitCollect > 0 then
                    itemsConfig.waitCollect = decoded.waitCollect
                end
                if type(decoded.slapAura) == "boolean" then
                    itemsConfig.slapAura = decoded.slapAura
                end
                if type(decoded.aimBotTomahawk) == "boolean" then
                    itemsConfig.aimBotTomahawk = decoded.aimBotTomahawk
                end
                if type(decoded.playersESP) == "boolean" then
                    itemsConfig.playersESP = decoded.playersESP
                end
                if type(decoded.itemsESP) == "boolean" then
                    itemsConfig.itemsESP = decoded.itemsESP
                end
                if type(decoded.antiKnockback) == "boolean" then
                    itemsConfig.antiKnockback = decoded.antiKnockback
                end
                if type(decoded.autoRejoin) == "boolean" then
                    itemsConfig.autoRejoin = decoded.autoRejoin
                end
                if type(decoded.fastSpeed) == "boolean" then
                    itemsConfig.fastSpeed = decoded.fastSpeed
                end
            end
        end
    end)
end

-- Gravação síncrona do estado das configurações em formato JSON
local function saveLocalConfig()
    pcall(function()
        if writefile then
            local dataToSave = HttpService:JSONEncode(itemsConfig)
            writefile(CONFIG_FILE_NAME, dataToSave)
        end
    end)
end

loadLocalConfig()

